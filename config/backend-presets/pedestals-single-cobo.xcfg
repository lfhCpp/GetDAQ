			</AsAd>
			<AsAd id="0">
				
				<CircularBuffer>
					
					<endOfMemory>0xA000000</endOfMemory>
				</CircularBuffer>
				<Control>
					<isActive>true</isActive>
				</Control>
			</AsAd>
			<AsAd id="1">
				
				<CircularBuffer>
					
					<endOfMemory>0xC000000</endOfMemory>
					
