<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0"><class>ColdHandoffWindow</class><widget class="QDialog" name="ColdHandoffWindow">
<property name="windowTitle"><string>Cold data handoff recovery</string></property>
<property name="geometry"><rect><x>0</x><y>0</y><width>1050</width><height>760</height></rect></property>
<layout class="QVBoxLayout" name="layout">
<item><widget class="QLabel" name="description"><property name="text"><string>Use the separate recovery service on the original ECC host after the original ECC has exited. The service runs the fixed native CLI. Qt only submits metadata and observes task IDs. Original failures and old hardware control remain fenced. Closing this window does not cancel a task.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><layout class="QFormLayout" name="form">
<item row="0" column="0"><widget class="QLabel" name="addressLabel"><property name="text"><string>Recovery host address</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="address"><property name="text"><string>127.0.0.1</string></property></widget></item>
<item row="1" column="0"><widget class="QLabel" name="portLabel"><property name="text"><string>Recovery service port</string></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="port"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>24101</number></property></widget></item>
<item row="2" column="0"><widget class="QLabel" name="credentialLabel"><property name="text"><string>Local recovery credential file (value hidden)</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="credential"></widget></item>
<item row="3" column="0"><widget class="QLabel" name="serviceLabel"><property name="text"><string>Expected recovery service ID</string></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="service"></widget></item>
<item row="4" column="0"><widget class="QLabel" name="taskLabel"><property name="text"><string>Original recovery task ID for observation</string></property></widget></item><item row="4" column="1"><widget class="QLineEdit" name="task"></widget></item>
<item row="5" column="0"><widget class="QLabel" name="attemptLabel"><property name="text"><string>Original cold attempt ID for read-only inspection</string></property></widget></item><item row="5" column="1"><widget class="QLineEdit" name="attempt"></widget></item>
</layout></item><item><layout class="QHBoxLayout" name="buttons"><item><widget class="QPushButton" name="check"><property name="text"><string>Check fixed recovery identity</string></property></widget></item><item><widget class="QPushButton" name="submit"><property name="text"><string>Confirm one cold data completion...</string></property></widget></item><item><widget class="QPushButton" name="observe"><property name="text"><string>Observe original task</string></property></widget></item><item><widget class="QPushButton" name="inspect"><property name="text"><string>Read-only inspect original attempt...</string></property></widget></item><item><widget class="QPushButton" name="newAttempt"><property name="text"><string>Review another attempt</string></property></widget></item><item><widget class="QPushButton" name="loadIntent"><property name="text"><string>Load saved intent...</string></property></widget></item><item><widget class="QPushButton" name="exportReceipt"><property name="text"><string>Export checked receipt...</string></property></widget></item></layout></item>
<item><widget class="QPlainTextEdit" name="identity"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>190</number></property></widget></item>
<item><widget class="QPlainTextEdit" name="result"><property name="readOnly"><bool>true</bool></property></widget></item>
<item><widget class="QLabel" name="status"><property name="text"><string>No task submitted. Check and review the fixed original request and successor identity.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
</layout></widget><resources/><connections/></ui>
