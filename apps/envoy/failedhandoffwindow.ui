<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>FailedHandoffWindow</class>
 <widget class="QDialog" name="FailedHandoffWindow">
  <property name="windowTitle"><string>Complete a failed data-node handoff</string></property>
  <property name="minimumSize"><size><width>820</width><height>650</height></size></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="instructions"><property name="text"><string>This tool is only for an original handoff-control operation that is explicitly failed on the same live data service after a normally stopped and sealed cycle. It never retries the original request. The helper first validates the saved request and live service; then you review a separate completion request before its one POST. If the reply is lost, use Observe only.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="queryAvailability"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #a00000; font-weight: bold;</string></property></widget></item>
   <item><layout class="QFormLayout" name="formLayout">
    <item row="0" column="0"><widget class="QLabel" name="hostLabel"><property name="text"><string>Data service IPv4</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="host"><property name="text"><string>127.0.0.1</string></property></widget></item>
    <item row="1" column="0"><widget class="QLabel" name="portLabel"><property name="text"><string>Control port</string></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="port"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>24001</number></property></widget></item>
    <item row="2" column="0"><widget class="QLabel" name="agentLabel"><property name="text"><string>Expected data node ID</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="agent"/></item>
    <item row="3" column="0"><widget class="QLabel" name="controllerLabel"><property name="text"><string>Expected controller ID</string></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="controller"/></item>
    <item row="4" column="0"><widget class="QLabel" name="planLabel"><property name="text"><string>Expected current plan SHA-256</string></property></widget></item><item row="4" column="1"><widget class="QLineEdit" name="plan"/></item>
    <item row="5" column="0"><widget class="QLabel" name="credentialLabel"><property name="text"><string>Local credential file (value is never shown)</string></property></widget></item><item row="5" column="1"><layout class="QHBoxLayout" name="credentialLayout"><item><widget class="QLineEdit" name="credential"/></item><item><widget class="QPushButton" name="browseCredential"><property name="text"><string>Browse...</string></property></widget></item></layout></item>
    <item row="6" column="0"><widget class="QLabel" name="originalLabel"><property name="text"><string>Saved original handoff request</string></property></widget></item><item row="6" column="1"><layout class="QHBoxLayout" name="originalLayout"><item><widget class="QLineEdit" name="original"/></item><item><widget class="QPushButton" name="browseOriginal"><property name="text"><string>Browse...</string></property></widget></item></layout></item>
    <item row="7" column="0"><widget class="QLabel" name="failedIdLabel"><property name="text"><string>Original failed operation ID</string></property></widget></item><item row="7" column="1"><widget class="QLineEdit" name="failedId"/></item>
    <item row="8" column="0"><widget class="QLabel" name="newIdLabel"><property name="text"><string>New completion operation ID</string></property></widget></item><item row="8" column="1"><widget class="QLineEdit" name="newId"/></item>
    <item row="9" column="0"><widget class="QLabel" name="outputLabel"><property name="text"><string>Private completion request file</string></property></widget></item><item row="9" column="1"><layout class="QHBoxLayout" name="outputLayout"><item><widget class="QLineEdit" name="output"/></item><item><widget class="QPushButton" name="browseOutput"><property name="text"><string>Browse...</string></property></widget></item></layout></item>
   </layout></item>
   <item><layout class="QHBoxLayout" name="buttons">
    <item><widget class="QPushButton" name="generate"><property name="text"><string>Validate and generate request</string></property></widget></item>
    <item><widget class="QPushButton" name="load"><property name="text"><string>Load saved request...</string></property></widget></item>
    <item><widget class="QPushButton" name="submit"><property name="text"><string>Submit this request once...</string></property></widget></item>
    <item><widget class="QPushButton" name="observe"><property name="text"><string>Observe operation</string></property></widget></item>
   </layout></item>
   <item><widget class="QPlainTextEdit" name="requestView"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>180</number></property></widget></item>
   <item><widget class="QPlainTextEdit" name="resultView"><property name="readOnly"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="status"><property name="text"><string>No completion request loaded. Nothing has been sent.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
  </layout>
 </widget>
