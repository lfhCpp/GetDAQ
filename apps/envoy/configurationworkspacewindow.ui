<ui version="4.0">
 <class>ConfigurationWorkspaceWindow</class>
 <widget class="QDialog" name="ConfigurationWorkspaceWindow">
  <property name="windowTitle"><string>Configuration workspace / Save All</string></property>
  <property name="geometry"><rect><x>0</x><y>0</y><width>1100</width><height>780</height></rect></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="description"><property name="text"><string>Open multiple local root configurations and edit their source tabs in memory. Shared includes have one tab. Review all roots before Save All. Saving replaces files one at a time; it is not a cross-file transaction or hardware deployment.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><layout class="QHBoxLayout" name="buttonLayout">
    <item><widget class="QPushButton" name="openRoot"><property name="text"><string>Add root configuration...</string></property></widget></item>
    <item><widget class="QPushButton" name="reviewAll"><property name="text"><string>Review all pending sources</string></property></widget></item>
    <item><widget class="QPushButton" name="structure"><property name="text"><string>Edit workspace structure...</string></property><property name="enabled"><bool>false</bool></property></widget></item>
    <item><widget class="QPushButton" name="undo"><property name="text"><string>Undo reviewed source group</string></property><property name="enabled"><bool>false</bool></property></widget></item>
    <item><widget class="QPushButton" name="redo"><property name="text"><string>Redo reviewed source group</string></property><property name="enabled"><bool>false</bool></property></widget></item>
    <item><widget class="QPushButton" name="saveAll"><property name="text"><string>Save All reviewed changes</string></property><property name="enabled"><bool>false</bool></property></widget></item>
    <item><widget class="QPushButton" name="recovery"><property name="text"><string>Inspect interrupted save...</string></property></widget></item>
   </layout></item>
   <item><widget class="QPushButton" name="migration"><property name="text"><string>Migrate a saved source file path...</string></property><property name="enabled"><bool>false</bool></property></widget></item>
   <item><widget class="QLabel" name="roots"><property name="text"><string>No root configuration open.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QTabWidget" name="sourceTabs"/></item>
   <item><widget class="QPlainTextEdit" name="review"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>230</number></property><property name="placeholderText"><string>Review lists files to replace and effective changes in every opened root.</string></property></widget></item>
   <item><widget class="QLabel" name="status"><property name="text"><string>Local files only. No hardware command is sent.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
  </layout>
 </widget>
