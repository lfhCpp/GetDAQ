<ui version="4.0"><class>HardwareStateWindow</class><widget class="QDialog" name="HardwareStateWindow"><property name="windowTitle"><string>Live hardware control bits / no recovery</string></property><property name="geometry"><rect><x>0</x><y>0</y><width>1200</width><height>680</height></rect></property><layout class="QVBoxLayout" name="layout"><item><widget class="QLabel" name="description"><property name="text"><string>Explicitly query fixed control bits and the controller-reported per-CoBo command phase through native ECC. Source may be a live cache or a cold controller baseline; lifecycle phase is not hardware readback. No arbitrary register reads, hardware writes, raw data, automatic polling or UNKNOWN clearing.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item><layout class="QFormLayout" name="fields"><item row="0" column="0"><widget class="QLabel" name="addressLabel"><property name="text"><string>ECC address</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="address"></widget></item><item row="1" column="0"><widget class="QLabel" name="portLabel"><property name="text"><string>ECC port</string></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="port"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property></widget></item><item row="2" column="0"><widget class="QLabel" name="credentialLabel"><property name="text"><string>Local credential file</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="credential"></widget></item><item row="3" column="0"><widget class="QLabel" name="serviceLabel"><property name="text"><string>Expected service ID</string></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="service"></widget></item><item row="4" column="0"><widget class="QLabel" name="snapshotLabel"><property name="text"><string>Exp