  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="Instructions"><property name="text"><string>Review the saved successor identity and every data node target after normal acquisition has ended. This window handles control metadata only. Node service replacement and successor startup remain explicit.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
