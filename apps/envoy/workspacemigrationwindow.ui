<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>WorkspaceMigrationWindow</class>
 <widget class="QDialog" name="WorkspaceMigrationWindow">
  <property name="windowTitle"><string>Migrate configuration source path</string></property>
  <property name="geometry"><rect><x>0</x><y>0</y><width>1000</width><height>700</height></rect></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="description"><property name="text"><string>Move one saved configuration source to a new path. References from every opened root and references inside the moved file are reviewed together. Add all affected roots before continuing; unopened projects are not searched.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QComboBox" name="source"/></item>
   <item><layout class="QHBoxLayout" name="destinationLayout">
    <item><widget class="QLineEdit" name="destination"><property name="placeholderText"><string>New file path; its parent directory must already exist</string></property></widget></item>
    <item><widget class="QPushButton" name="choose"><property name="text"><string>Choose destination...</string></property></widget></item>
   </layout></item>
   <item><layout class="QHBoxLayout" name="actionLayout">
    <item><widget class="QPushButton" name="preview"><property name="text"><string>Preview all roots and references</string></property></widget></item>
    <item><widget class="QPushButton" name="apply"><property name="text"><string>Confirm reviewed path migration...</string></property><property name="enabled"><bool>false</bool></property></widget></item>
   </layout></item>
   <item><widget class="QPlainTextEdit" name="review"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>230</number></property></widget></item>
   <item><widget class="QComboBox" name="reviewSource"/></item>
   <item><layout class="QHBoxLayout" name="sourceLayout">
    <item><widget class="QPlainTextEdit" name="before"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>Recorded original source</string></property></widget></item>
    <item><widget class="QPlainTextEdit" name="after"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>Reviewed candidate source</string></property></widget></item>
   </layout></item>
   <item><widget class="QLabel" name="status"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Local configuration files only. No hardware commands or raw data transfer.</string></property></widget></item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
