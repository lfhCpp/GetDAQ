<ui version="4.0"><class>WorkspaceRecoveryWindow</class><widget class="QDialog" name="WorkspaceRecoveryWindow"><property name="windowTitle"><string>Interrupted Save All recovery</string></property><property name="geometry"><rect><x>0</x><y>0</y><width>1000</width><height>650</height></rect></property><layout class="QVBoxLayout" name="layout">
<item><widget class="QLabel" name="description"><property name="text"><string>Inspect a retained save-* record after the original writer exits. Choose candidate completion or original restoration. Current files must match recorded states. Nothing is replayed automatically; no hardware command is sent.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><layout class="QHBoxLayout" name="pathLayout"><item><widget class="QLineEdit" name="directory"><property name="placeholderText"><string>Recovery record directory containing manifest.json</string></property></widget></item><item><widget class="QPushButton" name="choose"><property name="text"><string>Select record...</string></property></widget></item></layout></item>
<item><widget class="QComboBox" name="direction"/></item>
<item><widget class="QComboBox" name="source"/></item><item><widget class="QTabWidget" name="tabs"><widget class="QWidget" name="summary"><attribute name="title"><string>Recovery review</string></attribute><layout class="QVBoxLayout" name="reviewLayout"><item><widget class="QPlainTextEdit" name="review"><property name="readOnly"><bool>true</bool></property></widget></item></layout></widget><widget class="QWidget" name="currentPage"><attribute name="title"><string>Current disk source</string></attribute><layout class="QVBoxLayout" name="currentLayout"><item><widget class="QPlainTextEdit" name="current"><property name="readOnly"><bool>true</bool></property></widget></item></layout></widget><widget class="QWidget" name="targetPage"><attribute name="title"><string>Selected recovery target</string></attribute><layout class="QVBoxLayout" name="targetLayout"><item><widget class="QPlainTextEdit" name="target"><property name="readOnly"><bool>true</bool></property></widget></item></layout></widget></widget></item>
<item><widget class="QLabel" name="status"><property name="text"><string>Preview before recovery. No file has been written.</string></property><property name="textFormat"><enum>Qt::PlainText</enum></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><layout class="QHBoxLayout" name="buttons"><item><widget class="QPushButton" name="preview"><property name="text"><string>Preview recorded source states</string></property></widget></item><item><widget class="QPushButton" name="apply"><property name="text"><string>Confirm reviewed recovery</string></property><property name="enabled"><bool>false</bool></property></widget></item></layout></item>
</layout></widget><resources/><connections/></ui>
