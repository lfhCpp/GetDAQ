<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TransferWindow</class>
 <widget class="QDialog" name="TransferWindow">
  <property name="windowTitle"><string>Native data-host copy tasks</string></property>
  <property name="geometry"><rect><x>0</x><y>0</y><width>950</width><height>760</height></rect></property>
  <layout class="QVBoxLayout" name="layout">
   <item><widget class="QLabel" name="description"><property name="text"><string>Qt submits metadata and observes the original task ID. A separate native data-host process copies and verifies raw files. Closing this window does not stop it. Source data and ECC Run state are retained.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><layout class="QFormLayout" name="form">
    <item row="0" column="0"><widget class="QLabel" name="addressLabel"><property name="text"><string>Data-host address</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="address"><property name="text"><string>127.0.0.1</string></property></widget></item>
    <item row="1" column="0"><widget class="QLabel" name="portLabel"><property name="text"><string>Supervisor port</string></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="port"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>24001</number></property></widget></item>
    <item row="2" column="0"><widget class="QLabel" name="tokenLabel"><property name="text"><string>Local credential file (value hidden)</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="credential"/></item>
    <item row="3" column="0"><widget class="QLabel" name="agentLabel"><property name="text"><string>Expected data agent ID</string></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="agent"/></item>
    <item row="4" column="0"><widget class="QLabel" name="experimentLabel"><property name="text"><string>Completed experiment</string></property></widget></item><item row="4" column="1"><widget class="QLineEdit" name="experiment"/></item>
    <item row="5" column="0"><widget class="QLabel" name="runLabel"><property name="text"><string>Completed Run number</string></property></widget></item><item row="5" column="1"><widget class="QSpinBox" name="run"><property name="maximum"><number>2147483646</number></property></widget></item>
   </layout></item>
   <item><layout class="QHBoxLayout" name="buttons"><item><widget class="QPushButton" name="check"><property name="text"><string>Check identity and completed source</string></property></widget></item><item><widget class="QPushButton" name="submit"><property name="text"><string>Confirm new native copy</string></property></widget></item><item><widget class="QLineEdit" name="operation"><property name="placeholderText"><string>Original task ID for observation</string></property></widget></item><item><widget class="QPushButton" name="resume"><property name="text"><string>Resume original partial copy...</string></property></widget></item><item><widget class="QPushButton" name="reconcile"><property name="text"><string>Verify unresolved original copy...</string></property></widget></item><item><widget class="QPushButton" name="observe"><property name="text"><string>Observe original ID</string></property></widget></item></layout></item>
   <item><widget class="QPlainTextEdit" name="identity"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>130</number></property></widget></item>
   <item><widget class="QPlainTextEdit" name="result"><property name="readOnly"><bool>true</bool></property></widget></item>
   <item><widget class="QLabel" name="status"><property name="text"><string>Check a completed source before confirming. No hardware command is sent.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
  </layout>
 </widget>
