<?xml version="1.0" encoding="UTF-8"?>
<project name="EccJavaClient" default="jar" basedir=".">

	<echo message="Project name: ${ant.project.name}"/>
	<echo message="Ant version: ${ant.version}"/>
	<echo message="Java version: ${ant.java.version}"/>
	    	
	<target name="init">
		<property name="appname" value="EccClient" />

		<property name="top.dir" value="${basedir}/.." />
		<property name="src.dir" value="${basedir}" />
		<property name="build.src.dir" value="${basedir}/generated" />
		<property name="build.class.dir" value="${basedir}/class" />

		<property name="jarfile" value="${basedir}/${appname}.jar" />

		<property name="ice.libdir"     value="/usr/share/java"/>
		<path id="ice.classpath"	location="${ice.libdir}/Ice.jar"/>
		
		<path id="classpath">
			<pathelement location="${build.class.dir}" />
			<path refid="ice.classpath" />
		</path>

		<taskdef name="slice2java" classname="Slice2JavaTask" classpath="/usr/share/ant/lib/ant-ice.jar"/>

	</target>

	<target name="clean" depends="init">
		<delete dir="${build.class.dir}" />
		<delete dir="${build.src.dir}" />
		<delete file="${jarfile}" />
	</target>

	<target name="jar" depends="compile">
		<delete file="${jarfile}" />
		<jar jarfile="${jarfile}">
			<fileset dir="${build.class.dir}">
				<include name="**/*.class" />
			</fileset>
		</jar>
	</target>

	<target name="compile" depends="clean,init">
		<mkdir dir="${build.src.dir}" />
		<slice2java includepath="/usr/share/slice" outputdir="${build.src.dir}">
			<fileset dir="${src.dir}">
				<include name="**/*.ice"/>
			</fileset>
		</slice2java>
		<mkdir dir="${build.class.dir}" />
		<javac srcdir="${build.src.dir}" destdir="${build.class.dir}" debug="on" deprecation="on" classpathref="classpath" optimize="off" includes="**/*.java" />
		<javac srcdir="${src.dir}" destdir="${build.class.dir}" debug="on" deprecation="on" classpathref="classpath" optimize="off" includes="**/*.java" />
	</target>

	<target name="all" depends="jar">
	</target>

</project>